# Routing provider for live data (Phase 2C) — server-side only.
# ROUTING_PROVIDER=valhalla (default): keyless public demo server for
#   development, or your own Valhalla when VALHALLA_BASE_URL is set.
# ROUTING_PROVIDER=openrouteservice: hosted ORS — requires ORS_API_KEY
#   (free Standard account at openrouteservice.org; the key belongs to
#   one person and must never reach the browser).
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=
ORS_API_KEY=

# Legacy placeholder for the deferred Google Maps idea. Not used by the
# current application (the open-source routing stack replaced it).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
